{
  "name": "Python 3",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  "forwardPorts": [8000],
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y python3-pip && pip install -r requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.debugpy",
        "GitHub.copilot-chat",
        "GitHub.copilot"
      ]
    }
  }
}
